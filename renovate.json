{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard", "group:monorepos", "group:recommended"],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 1,
  "ignoreDeps": ["registry.ddbuild.io/dd-octo-sts"],
  "schedule": ["every weekend"],
  "postUpdateOptions": ["yarnDedupeHighest"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Node.js and Playwright need a CI image rebuild: keep them out of the all-minor-patch batch",
      "matchDepNames": ["node", "@playwright/test"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Node.js and Playwright",
      "groupSlug": "ci-image"
    },
    {
      "description": "Test apps resolve SDK packages to local package.tgz builds, and some (e.g. browser-debugger) are not published on npm",
      "matchFileNames": ["test/apps/**"],
      "matchPackageNames": ["@datadog/browser-*"],
      "enabled": false
    },
    {
      "description": "The vanilla app's typescript is replaced by each check of scripts/check-typescript-compatibility.ts, so its committed version doesn't matter",
      "matchFileNames": ["test/apps/vanilla/**"],
      "matchDepNames": ["typescript"],
      "enabled": false
    },
    {
      "matchFileNames": ["test/apps/angular-app/**"],
      "matchPackageNames": ["@angular/**", "@angular-devkit/**", "@ngtools/**", "typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "react-router-dom-6 is an alias kept on v6 to test the v6 integration",
      "matchFileNames": ["packages/browser-rum-react/package.json"],
      "matchDepNames": ["react-router-dom-6"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The Node 20 Dockerfile stage installs the browsers of the Playwright version pinned for old-browser e2e jobs",
      "matchFileNames": ["Dockerfile"],
      "matchDepNames": ["node"],
      "matchCurrentValue": "/^20/",
      "enabled": false
    },
    {
      "description": "webpack 5.112.0-5.112.2 moved internal files that @module-federation/enhanced imports (https://github.com/webpack/webpack/issues/22932)",
      "matchFileNames": ["test/apps/microfrontend/**"],
      "matchDepNames": ["webpack"],
      "allowedVersions": "<5.112.0 || >5.112.2"
    }
  ],
  "toolSettings": {
    "nodeMaxMemory": 2048
  }
}
