{
  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "moduleResolution": "bundler",
    "module": "ES2020",
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2018",
    "sourceMap": true,
    "jsx": "react",
    "skipLibCheck": true,

    "types": [],
    "lib": ["ES2020", "DOM", "WebWorker"],

    "paths": {
      "@datadog/browser-core": ["./packages/core/src"],
      "@datadog/core-next": ["./packages/core-next/src"],
      "@datadog/browser-core-next": ["./packages/browser-core-next/src"],
      "@datadog/browser-console-next": ["./packages/browser-console-next/src"],
      "@datadog/browser-console-next/collectors": ["./packages/browser-console-next/src/collectors"],
      "@datadog/browser-errors-next": ["./packages/browser-errors-next/src"],
      "@datadog/browser-errors-next/collectors": ["./packages/browser-errors-next/src/collectors"],
      "@datadog/browser-network-next": ["./packages/browser-network-next/src"],
      "@datadog/browser-network-next/collectors": ["./packages/browser-network-next/src/collectors"],
      "@datadog/browser-performance-next": ["./packages/browser-performance-next/src"],
      "@datadog/browser-performance-next/collectors": ["./packages/browser-performance-next/src/collectors"],
      "@datadog/browser-logs-next": ["./packages/browser-logs-next/src"],
      "@datadog/browser-logs-next/processor": ["./packages/browser-logs-next/src/processor"],
      "@datadog/browser-rum-next": ["./packages/browser-rum-next/src"],
      "@datadog/browser-rum-next/collectors": ["./packages/browser-rum-next/src/collectors"],
      "@datadog/browser-rum-next/processor": ["./packages/browser-rum-next/src/processor"],
      "@datadog/browser-views-next": ["./packages/browser-views-next/src"],
      "@datadog/browser-views-next/collectors": ["./packages/browser-views-next/src/collectors"],
      "@datadog/browser-views-next/processor": ["./packages/browser-views-next/src/processor"],
      "@datadog/browser-sdk": ["./packages/browser-sdk/src"],

      "@datadog/browser-logs": ["./packages/logs/src/entries/main"],

      "@datadog/browser-rum-core": ["./packages/rum-core/src"],

      "@datadog/browser-rum": ["./packages/rum/src/entries/main"],
      "@datadog/browser-rum/internal": ["./packages/rum/src/entries/internal"],
      "@datadog/browser-rum/internal-synthetics": ["./packages/rum/src/entries/internalSynthetics"],

      "@datadog/browser-rum-slim": ["./packages/rum-slim/src/entries/main"],

      "@datadog/browser-rum-react": ["./packages/rum-react/src/entries/main"],
      "@datadog/browser-rum-react/internal": ["./packages/rum-react/src/entries/internal"],
      "@datadog/browser-rum-react/react-router-v6": ["./packages/rum-react/src/entries/reactRouterV6"],
      "@datadog/browser-rum-react/react-router-v7": ["./packages/rum-react/src/entries/reactRouterV7"],
      "@datadog/browser-rum-react/tanstack-router": ["./packages/rum-react/src/entries/tanstackRouter"],

      "@datadog/browser-rum-vue": ["./packages/rum-vue/src/entries/main"],
      "@datadog/browser-rum-vue/vue-router-v4": ["./packages/rum-vue/src/entries/vueRouter"],

      "@datadog/browser-rum-nuxt": ["./packages/rum-nuxt/src/entries/main"],

      "@datadog/browser-rum-nextjs": ["./packages/rum-nextjs/src/entries/main"],

      "@datadog/browser-worker": ["./packages/worker/src/entries/main"]
    }
  }
}
