{
  "name": "@datadog/browser-rum-buffer",
  "version": "7.16.2",
  "license": "Apache-2.0",
  "main": "cjs/entries/main.js",
  "module": "esm/entries/main.mjs",
  "types": "cjs/entries/main.d.ts",
  "files": [
    "bundle/**/*.js",
    "cjs",
    "esm",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.specHelper.ts"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-package.ts --modules --bundle datadog-rum-buffer.js=./src/entries/standalone.ts",
    "build:bundle": "node ../../scripts/build/build-package.ts --bundle datadog-rum-buffer.js=./src/entries/standalone.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@datadog/browser-core": "workspace:*",
    "@datadog/js-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DataDog/browser-sdk.git",
    "directory": "packages/browser-rum-buffer"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/entries/standalone.ts",
    "./cjs/entries/standalone.js",
    "./esm/entries/standalone.mjs"
  ]
}
